# ==============================================================================
# Lenny Growth Assistant — Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL in Docker, SQLite fallback for local quick-start)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/growth_assistant
# For local zero-dependency run without Docker Postgres, use:
# DATABASE_URL=sqlite:///./growth_assistant.db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=growth_assistant

# LLM Providers (Cloud & Local)
# ------------------------------------------------------------------------------
# Google Gemini (Primary for Grounded Retrieval QA & Intent Routing)
# Get key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter (Primary for Long-form Ship 30/30 Essays & Multi-Model Access)
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local Ollama Endpoint (Mandatory offline demo mode fallback)
# Default for host machine: http://localhost:11434
# Default inside docker compose: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434

# Task-Based Model Router Defaults (Env overridable without code changes)
# Google Gemini — free tier
MODEL_FOR_INTENT_ROUTING=gemini-2.5-flash-lite
MODEL_FOR_RETRIEVAL_QA=gemini-2.5-flash
MODEL_FOR_ARTIFACT=gemini-2.5-flash

# OpenRouter — free models only
MODEL_FOR_ESSAY=openrouter/free

# Local Ollama — completely offline
MODEL_FOR_OFFLINE=llama3.2:3b

# CORS Configuration (Backend)
# ------------------------------------------------------------------------------
CORS_ORIGINS=https://lennyassistant.pradeepleadsystems.in,http://localhost:3000,http://127.0.0.1:3000

# Frontend Environment Variables
# ------------------------------------------------------------------------------
# For local dev: FASTAPI_URL=http://localhost:8000
# For production on Vercel: FASTAPI_URL=https://lenny-growth-assistant-y0bi.onrender.com
FASTAPI_URL=https://lenny-growth-assistant-y0bi.onrender.com
NEXT_PUBLIC_API_URL=/api
